# Variables del backend del sistema de certificaciones.
#
# Copiar a .env y completar. Este archivo SÍ va al repositorio; el .env NO
# porque tiene contraseñas.

PORT=3000
NODE_ENV=development
# La URL del frontend. En producción es la única que CORS acepta.
FRONTEND_URL=http://localhost:5174

# ── Base de datos ───────────────────────────────────────────────────────
#
# ⚠️ EN LA MÁQUINA DE DESARROLLO, DEJAR LOCALHOST.
#
# Apuntar el .env local a la base de producción es cómodo para mirar datos
# reales, y es también la forma más fácil de romper producción: este servidor
# sincroniza tablas y migra AL ARRANCAR. Ya pasó una vez.
#
# El freno está puesto (ver MIGRAR_EN_ARRANQUE), pero la costumbre sana es
# trabajar contra una base local y dejar las credenciales reales solo en Render.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=certificaciones
DB_USER=root
DB_PASSWORD=

# ⚠️ SOLO en el servidor de producción.
#
# Sin esta variable, el servidor se niega a tocar el esquema cuando la base NO
# es local: atiende normalmente, pero no sincroniza ni migra.
# MIGRAR_EN_ARRANQUE=true

# ── Seguridad ───────────────────────────────────────────────────────────
# Largo y aleatorio, y DISTINTO del de desarrollo.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── API entre sistemas (la consume el sistema de costos) ────────────────
#
# Expone /api/publica/*: obras, certificados, y el avance TOPADO a lo
# planificado. El excedente NO cruza, a propósito.
#
# Si este token no está configurado, la API queda CERRADA (503) en vez de
# abierta: un endpoint que se abre solo porque falta una variable es la manera
# más fácil de publicar los números de la empresa sin querer.
# API_TOKEN=

# ── Aviso al sistema de costos ──────────────────────────────────────────
#
# Cuando se emite, edita, anula o reactiva un certificado, este sistema le
# avisa al de costos para que arme la factura sola.
#
# Si falla, el certificado se emite igual: avisar es una cortesía y no puede
# hacer fallar el trabajo propio.
#
# COSTOS_API_TOKEN tiene que ser el MISMO valor que CERTIF_API_TOKEN en el
# .env de costos, y que API_TOKEN de acá arriba.
# COSTOS_API_URL=https://costos-mdf-backend.onrender.com
# COSTOS_API_TOKEN=
